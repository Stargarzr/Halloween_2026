# Hosted Netlify app: set these as environment variables, never in source control.
# Use the Supabase transaction-pooler connection URL with sslmode=require.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required in production: the absolute HTTPS origin used for Supabase email callbacks.
SITE_URL=
# Secret: server-only photo access. Never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=
# Optional AI image editing, billed separately.
OPENAI_API_KEY=
# With no Supabase config, npm run dev uses local-only preview roles and .local-contest/.
# Production always requires Supabase configuration; there is no hosted preview bypass.
