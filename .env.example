# Hosted Netlify app: set variables in the Netlify UI for the production context (all scopes; scoping is a paid feature).
# Keep SITE_URL and SUPABASE_CA_CERT there, not in netlify.toml. Redeploy after changes.
# Never commit credentials.
# Start with the Supabase transaction-pooler URL using sslmode=require; test from Netlify.
# On a certificate error: remove sslmode and all other ssl* URL parameters,
# then set SUPABASE_CA_CERT to the project's complete PEM CA certificate (real line breaks).
# Never use rejectUnauthorized:false or NODE_TLS_REJECT_UNAUTHORIZED=0.
DATABASE_URL=
SUPABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required in production: absolute HTTPS origin, without a path/query/fragment.
# Example: https://your-contest.netlify.app
# Match Supabase's Site URL and allowlist this origin plus /auth/callback.
SITE_URL=
# Secret: server-only photo access. Never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=
# Optional Cloudflare R2 photo storage (S3 API token): when all four are set, R2 takes precedence over Supabase Storage.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional paid AI editing: sends contestant photos to the chosen vendor; obtain contestant consent.
# AI_VENDOR selects it: openai | google | unset. Unset (the default) disables AI editing and the
# "Suggest a tagline" button only uses the built-in presets, including when company policy prohibits AI.
AI_VENDOR=
# AI_TAGLINES=true also returns a suggested tagline with each generated background
# (Google: one call returns image and text; OpenAI: a second vision call). Default false.
AI_TAGLINES=false
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides: AI_OPENAI_IMAGE_MODEL (gpt-image-2), AI_OPENAI_TEXT_MODEL (gpt-5-mini), AI_GOOGLE_IMAGE_MODEL (gemini-2.5-flash-image).
# Apply migrations 0001, 0002, and 0003; configure custom SMTP and raise OTP/verify limits.
# See README for both email templates, arrival-burst sizing, and the pre-launch checklist.
# With no Supabase config, npm run dev uses local-only preview roles and .local-contest/.
# Production always requires Supabase configuration; there is no hosted preview bypass.
